<?xml version="1.0" encoding="UTF-8" ?>
<!-- Opt-in six-camera trial budget. Process-local; no system settings changed.
     6 RGB + 6 BGR images at 640x480 plus UAV/recording images, depth 5,
     exceed the original single-robot shm64 allowance. All participants may
     select this file consistently for a full-sensor selfplay trial. -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>maicon_shm256</transport_id>
      <type>SHM</type>
      <segment_size>268435456</segment_size>
    </transport_descriptor>
    <transport_descriptor>
      <transport_id>maicon_udp</transport_id>
      <type>UDPv4</type>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="maicon_local_shm256" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>maicon_shm256</transport_id>
        <transport_id>maicon_udp</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
