<?xml version="1.0" encoding="UTF-8" ?>
<!-- Explicit local Fast DDS profile, verified on the recorded WSL environment.
     Start all compared ROS publishers/subscribers with
     FASTRTPS_DEFAULT_PROFILES_FILE=/absolute/path/to/this/file.
     No OS-global shared-memory/sysctl settings are changed.
     UDPv4 remains available for discovery and non-SHM peers.
     A depth-5 budget for ego RGB + BGR, UAV and validation RGB images is
     50,040,000 bytes, or 62,550,000 with 25% serialization/queue allowance.
     64 MiB is sufficient for that estimate, not arbitrary new cameras/depths. -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>maicon_shm64</transport_id>
      <type>SHM</type>
      <segment_size>67108864</segment_size>
    </transport_descriptor>
    <transport_descriptor>
      <transport_id>maicon_udp</transport_id>
      <type>UDPv4</type>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="maicon_local_shm64" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>maicon_shm64</transport_id>
        <transport_id>maicon_udp</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
