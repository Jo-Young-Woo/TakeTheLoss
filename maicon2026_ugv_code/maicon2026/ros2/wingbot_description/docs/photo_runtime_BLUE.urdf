  <gazebo reference="left_up_wheel_link">
    <!-- The local Z axle does not rotate with wheel spin. It stays tangent
           to the ground; local X would rotate vertically every revolution. -->
    <fdir1>0 0 1</fdir1>
    <mu1>0.03</mu1>
    <mu2>0.8</mu2>
    <kp>100000</kp>
    <kd>100</kd>
    <maxVel>0.1</maxVel>
    <minDepth>0.001</minDepth>
  </gazebo>
