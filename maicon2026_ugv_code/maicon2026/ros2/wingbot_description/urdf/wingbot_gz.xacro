<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Fortress plugin filenames/classes have one authority here. No Classic plugins. -->
  <xacro:macro name="wingbot_wheel_surface" params="prefix side position">
    <gazebo reference="${prefix}${side}_${position}_wheel_link">
      <!-- The local Z axle does not rotate with wheel spin. It stays tangent
           to the ground; local X would rotate vertically every revolution. -->
      <fdir1>0 0 1</fdir1>
      <mu1>${friction_lateral}</mu1><mu2>${friction_longitudinal}</mu2><kp>100000</kp><kd>100</kd>
      <maxVel>0.1</maxVel><minDepth>0.001</minDepth>
    </gazebo>
  </xacro:macro>
  <xacro:macro name="wingbot_gazebo" params="prefix namespace sensors depth wheels effective_separation friction_lateral friction_longitudinal">
    <xacro:property name="m" value="${xacro.load_yaml('../config/wingbot_mods.yaml')}"/>
    <gazebo>
      <plugin filename="ignition-gazebo-diff-drive-system" name="ignition::gazebo::systems::DiffDrive">
        <left_joint>${prefix}left_middle_wheel_link_joint</left_joint>
        <right_joint>${prefix}right_middle_wheel_link_joint</right_joint>
        <xacro:if value="${int(wheels) == 6}">
          <left_joint>${prefix}left_up_wheel_link_joint</left_joint>
          <left_joint>${prefix}left_down_wheel_link_joint</left_joint>
          <right_joint>${prefix}right_up_wheel_link_joint</right_joint>
          <right_joint>${prefix}right_down_wheel_link_joint</right_joint>
        </xacro:if>
        <wheel_separation>${effective_separation}</wheel_separation>
        <wheel_radius>${m['wheels']['radius']}</wheel_radius>
        <odom_publish_frequency>20</odom_publish_frequency>
        <min_linear_velocity>-0.6</min_linear_velocity><max_linear_velocity>0.6</max_linear_velocity>
        <min_angular_velocity>-3.0</min_angular_velocity><max_angular_velocity>3.0</max_angular_velocity>
        <topic>${namespace}/cmd_vel</topic><odom_topic>${namespace}/odom</odom_topic><tf_topic>${namespace}/tf</tf_topic>
        <frame_id>${prefix}odom</frame_id><child_frame_id>${prefix}base_footprint</child_frame_id>
      </plugin>
      <plugin filename="ignition-gazebo-joint-state-publisher-system" name="ignition::gazebo::systems::JointStatePublisher">
        <topic>${namespace}/joint_states</topic>
      </plugin>
      <plugin filename="ignition-gazebo-joint-position-controller-system" name="ignition::gazebo::systems::JointPositionController">
        <joint_name>${prefix}${m['pan_tilt']['pan_joint']}</joint_name><topic>${namespace}/pan/cmd_pos</topic>
        <p_gain>6</p_gain><i_gain>0</i_gain><d_gain>0.1</d_gain><cmd_max>3</cmd_max><cmd_min>-3</cmd_min>
      </plugin>
      <plugin filename="ignition-gazebo-joint-position-controller-system" name="ignition::gazebo::systems::JointPositionController">
        <joint_name>${prefix}${m['pan_tilt']['tilt_joint']}</joint_name><topic>${namespace}/tilt/cmd_pos</topic>
        <p_gain>6</p_gain><i_gain>0</i_gain><d_gain>0.1</d_gain><cmd_max>3</cmd_max><cmd_min>-3</cmd_min>
      </plugin>
    </gazebo>
    <xacro:wingbot_wheel_surface prefix="${prefix}" side="left" position="up"/>
    <xacro:wingbot_wheel_surface prefix="${prefix}" side="left" position="middle"/>
    <xacro:wingbot_wheel_surface prefix="${prefix}" side="left" position="down"/>
    <xacro:wingbot_wheel_surface prefix="${prefix}" side="right" position="up"/>
    <xacro:wingbot_wheel_surface prefix="${prefix}" side="right" position="middle"/>
    <xacro:wingbot_wheel_surface prefix="${prefix}" side="right" position="down"/>
    <xacro:if value="${sensors == 'full'}">
      <gazebo reference="${prefix}pt_camera_link">
        <sensor name="wingbot_camera" type="camera">
          <always_on>true</always_on><update_rate>${m['camera']['rate_hz']}</update_rate><visualize>false</visualize>
          <topic>${namespace}/camera/image</topic><ignition_frame_id>${prefix}pt_camera_optical_link</ignition_frame_id>
          <camera><horizontal_fov>${m['camera']['hfov_rad']}</horizontal_fov>
            <image><width>${m['camera']['resolution'][0]}</width><height>${m['camera']['resolution'][1]}</height><format>R8G8B8</format></image>
            <clip><near>0.01</near><far>20</far></clip>
            <distortion><k1>-0.25</k1><k2>0</k2><k3>0</k3><p1>0</p1><p2>0</p2><center>0.5 0.5</center></distortion>
            <camera_info_topic>${namespace}/camera/camera_info</camera_info_topic>
          </camera>
        </sensor>
      </gazebo>
      <gazebo reference="${prefix}lidar_scan_link">
        <sensor name="wingbot_lidar" type="gpu_lidar">
          <always_on>true</always_on><update_rate>${m['lidar']['rate_hz']}</update_rate><visualize>false</visualize>
          <topic>${namespace}/scan</topic><ignition_frame_id>${prefix}lidar_scan_link</ignition_frame_id>
          <lidar><scan><horizontal><samples>${m['lidar']['samples']}</samples><resolution>1</resolution><min_angle>-${pi}</min_angle><max_angle>${pi}</max_angle></horizontal></scan>
            <range><min>${m['lidar']['range'][0]}</min><max>${m['lidar']['range'][1]}</max><resolution>0.001</resolution></range>
          </lidar>
        </sensor>
      </gazebo>
      <gazebo reference="${prefix}base_imu_link">
        <sensor name="wingbot_imu" type="imu">
          <always_on>true</always_on><update_rate>${m['imu']['rate_hz']}</update_rate><visualize>false</visualize>
          <topic>${namespace}/imu</topic><ignition_frame_id>${prefix}base_imu_link</ignition_frame_id><imu/>
        </sensor>
      </gazebo>
      <xacro:if value="${depth}">
        <gazebo reference="${prefix}3d_camera_link">
          <sensor name="wingbot_depth" type="depth_camera">
            <always_on>true</always_on><update_rate>5</update_rate><visualize>false</visualize>
            <topic>${namespace}/depth</topic><ignition_frame_id>${prefix}3d_camera_link</ignition_frame_id>
            <camera><horizontal_fov>1.2</horizontal_fov><image><width>320</width><height>240</height><format>R_FLOAT32</format></image><clip><near>0.1</near><far>10</far></clip></camera>
          </sensor>
        </gazebo>
      </xacro:if>
    </xacro:if>
  </xacro:macro>
</robot>
