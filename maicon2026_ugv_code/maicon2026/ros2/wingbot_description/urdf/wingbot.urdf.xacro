<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="wingbot">
  <xacro:arg name="model_name" default="wingbot"/>
  <xacro:arg name="team" default="BLUE"/>
  <xacro:arg name="prefix" default=""/>
  <xacro:arg name="namespace" default="/wingbot"/>
  <xacro:arg name="sensors" default="full"/>
  <xacro:arg name="depth" default="false"/>
  <xacro:arg name="wheels" default="6"/>
  <xacro:arg name="effective_separation" default="0.1745"/>
  <xacro:arg name="friction_lateral" default="0.03"/>
  <xacro:arg name="friction_longitudinal" default="0.8"/>
  <xacro:attribute name="name" value="$(arg model_name)"/>
  <xacro:include filename="wingbot_props.xacro"/>
  <xacro:include filename="wingbot_gz.xacro"/>
  <xacro:wingbot_body prefix="$(arg prefix)" team="$(arg team)" wheels="$(arg wheels)"/>
  <xacro:wingbot_gazebo prefix="$(arg prefix)" namespace="$(arg namespace)" sensors="$(arg sensors)" depth="$(arg depth)" wheels="$(arg wheels)" effective_separation="$(arg effective_separation)" friction_lateral="$(arg friction_lateral)" friction_longitudinal="$(arg friction_longitudinal)"/>
</robot>
