        <visual name="rover_wheel">
          <pose>0.000000 0.000000 0.000000 1.570796 0.000000 0.000000</pose>
          <geometry>
            <mesh>
              <uri>assets/ugv_rover/right_down_wheel_link.stl</uri>
            </mesh>
          </geometry>
          <material>
            <ambient>.018 .020 .023 1</ambient>
            <diffuse>.018 .020 .023 1</diffuse>
            <specular>.06 .06 .06 1</specular>
          </material>
        </visual>
      </link>
      <joint name="wheel_rear_right_joint" type="revolute">
        <parent>base_link</parent>
        <child>wheel_rear_right</child>
        <axis>
          <xyz>0 1 0</xyz>
          <limit>
            <lower>-1e16</lower>
            <upper>1e16</upper>
          </limit>
          <dynamics>
            <damping>.002</damping>
          </dynamics>
        </axis>
      </joint>
      <plugin filename="libignition-gazebo-diff-drive-system.so" name="ignition::gazebo::systems::DiffDrive">
        <left_joint>wheel_front_left_joint</left_joint>
        <right_joint>wheel_front_right_joint</right_joint>
        <wheel_separation>0.17452</wheel_separation>
        <wheel_radius>0.04</wheel_radius>
        <topic>/R3/cmd_vel</topic>
        <odom_topic>/R3/odom</odom_topic>
        <frame_id>odom</frame_id>
        <child_frame_id>base_link</child_frame_id>
        <odom_publish_frequency>30</odom_publish_frequency>
      </plugin>
    </model>
  </world>
</sdf>