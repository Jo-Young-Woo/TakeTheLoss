+def ident_cands(cfg, g, cov, ex, pose=(2.0, 2.5, 0.0), now=11.0):
+    blocked, _ = cov.planning_cost_maps(g)
+    return [c for c in ex.build(Pose2D(*pose), g, blocked, now, team=None) if c.kind == "identify"]
