+    assert g2.ugv_excluded == 0                                         # UGV 를 모르면 아무것도 빼지 않는다
+    g2.set_ugv_points([(float("nan"), 1.0, 0.2), (2.0, 2.0, 0.2)])
+    assert g2.ugv_points == [(2.0, 2.0, 0.2)]
