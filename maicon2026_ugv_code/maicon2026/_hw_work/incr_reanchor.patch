+    walls_before = None if cl.walls is None else cl.walls.copy()
+    st.grid.L[:] = 0.0
+    ix = int((TRUE[0] + 1.0 - st.grid.ox) / st.grid.res)
+    iy = int((TRUE[1] - st.grid.oy) / st.grid.res)
+    st.grid.L[iy, ix] = 4.0                                          # 로봇 앞 1 m 의 점유 셀(옛 앵커 기준으로 쌓인 것)
