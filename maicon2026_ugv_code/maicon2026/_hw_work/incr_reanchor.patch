+    cfg.pose_guard.reanchor = True
+    cfg.nav2.grid_source = "scan"
+    for k, v in over.items():
+        setattr(cfg.pose_guard, k, v)
+    m0 = (0.4, -0.3, 0.1)                                            # SLAM 지도 프레임의 시작 자세(임의)
+    cl = StubClient(m0)
+    st = Nav2Stack(cfg, cl)
+    st.guard.fit = fit()
+    true0 = Pose2D(*TRUE)
+    st.anchor = Anchor.from_pair(true0, m0)
+    st.pose = true0.copy()
