+SPOTS = [(0.9, 0.8, 0.0), (3.3, 2.6, 0.0), (1.0, 4.2, 0.0), (4.5, 2.2, 1.0), (5.0, 0.9, 2.0), (0.9, 2.5, 0.0), (5.2, 4.2, 3.0), (2.8, 0.7, 1.5)]
+
+
+def _tour(shift, **over):
+    w = _shifted_world(shift)
+    g = ra_guard(**over)
+    t = 0.0
+    for A in SPOTS * 2:
+        for _ in range(12):
+            g.process(t, Pose2D(*A), ODOM, _scan_in(w, A, t))
+            t += 0.5
+    return g, w, t
