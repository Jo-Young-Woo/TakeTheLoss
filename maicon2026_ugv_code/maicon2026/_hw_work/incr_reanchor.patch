+def rigid_resample(arr: np.ndarray, ox: float, oy: float, res: float, pivot: Pt, trim: Tuple[float, float, float], fill=0) -> np.ndarray:
+    """격자(arr[iy, ix], 셀 중심 = ox+(ix+.5)·res, oy+(iy+.5)·res)를 경기장 좌표 변환 p' = R(dth)(p−pivot)+pivot+d 로 옮긴 새 배열(최근접 표본).
+    원본 밖에서 오는 셀은 fill. 앵커 재설정 때 '경기장 좌표로 쌓아 둔' 점유·관측 격자를 새 앵커에 맞춘다."""
+    dx, dy, dth = trim
+    c, s = math.cos(dth), math.sin(dth)
+    ny, nx = arr.shape
+    X, Y = np.meshgrid(ox + (np.arange(nx) + 0.5) * res, oy + (np.arange(ny) + 0.5) * res)
+    qx, qy = X - pivot[0] - dx, Y - pivot[1] - dy
+    px, py = c * qx + s * qy + pivot[0], -s * qx + c * qy + pivot[1]
+    ix = np.floor((px - ox) / res).astype(int)
+    iy = np.floor((py - oy) / res).astype(int)
+    ok = (ix >= 0) & (ix < nx) & (iy >= 0) & (iy < ny)
+    out = np.full_like(arr, fill)
+    out[ok] = arr[iy[ok], ix[ok]]
+    return out
