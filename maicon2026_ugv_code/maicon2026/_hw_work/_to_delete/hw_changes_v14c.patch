+def test_empty_mask_returns_an_unchanged_copy(node):
+    amin, inc, r = _scan()
+    r[5] = 0.1
+    out = node.mask_ranges(amin, inc, r, 0.05, 8.0, 0.0, 0.0, 0.0, node.build_mask((), 0.35, 0.0))
+    assert np.array_equal(out, r) and out is not r
