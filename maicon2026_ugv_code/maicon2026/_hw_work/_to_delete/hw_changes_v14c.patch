+    # ------------------------------------------------------------------ 도구용
+    def arena_to_pixels(self, points: Sequence[Sequence[float]], plane_z: Optional[float] = None) -> np.ndarray:
+        """아레나 XY(주어진 높이 평면 위) → 원본 영상 화소. 겹쳐 그리기와 색 표본 위치에 쓴다."""
