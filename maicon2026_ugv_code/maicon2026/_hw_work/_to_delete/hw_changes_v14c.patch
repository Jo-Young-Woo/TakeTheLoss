+class KillProc:
+    pid = 999
+
+    def __init__(self, dies_on_int=True, alive=True):
+        self.alive, self.dies_on_int, self.signals = alive, dies_on_int, []
+
+    def poll(self):
+        return None if self.alive else 0
+
+    def wait(self, timeout=None):
+        if self.alive:
+            raise TimeoutError("still running")
+        return 0
