+def _seed_ledger(a, sector, n_boxes=2):
+    cov = a.coverage
+    cov.boxes = {}
+    cx, cy = a.cfg.arena.sector_center(sector)
+    for i in range(n_boxes):
+        b = BoxModel(i + 1, cx + 0.7 * i, cy, "full", [], 0., 0., full_seen=3, last_full_t=1.)
+        cov._make_faces(b)
+        cov.boxes[b.bid] = b
