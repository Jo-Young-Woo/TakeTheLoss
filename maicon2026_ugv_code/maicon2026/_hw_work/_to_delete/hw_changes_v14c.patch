+    fg_fraction: float = 0.0                     # 아레나 안에서 윗면 색으로 분류된 화소 비율
+    components: int = 0
+    rejects: Dict[str, int] = field(default_factory=dict)
+    note: str = ""                               # 프레임은 썼지만 이상한 점: no_dark_region(윗면색 화소가 거의 없다 — 빈 경기장이거나 노출·문턱이 틀렸다)
