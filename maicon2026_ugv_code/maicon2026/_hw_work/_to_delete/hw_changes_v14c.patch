+def suggest_thresholds(box_probes: Sequence[Dict[str, Any]], floor_probes: Sequence[Dict[str, Any]],
+                       min_floor_contrast: float = 1.6) -> Dict[str, Any]:
+    """상자 윗면 표본과 바닥 표본에서 uav_boxes.* 값을 제안한다. 근거 숫자와 함께 돌려주고, 못 정하면 ok=False + 이유.
