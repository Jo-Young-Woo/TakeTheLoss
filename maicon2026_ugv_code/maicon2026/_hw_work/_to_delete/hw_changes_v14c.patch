+def aim_cfg(model):
+    cfg = Config()
+    cfg.camera = fisheye_cfg() if model == "fisheye" else CameraCfg(K=K_FISH)
+    cfg.aim.laser_lateral_m = cfg.aim.laser_vertical_m = 0.0
+    cfg.aim.laser_offset_pan_deg = cfg.aim.laser_offset_tilt_deg = 0.0
+    return cfg
