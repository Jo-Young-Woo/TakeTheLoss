+    def to_dict(self) -> Dict[str, Any]:
+        return {"cx": round(self.cx, 3), "cy": round(self.cy, 3), "fill": round(self.fill, 3), "conf": round(self.conf, 3),
+                "status": self.status, "reason": self.reason, "comp": self.comp}
