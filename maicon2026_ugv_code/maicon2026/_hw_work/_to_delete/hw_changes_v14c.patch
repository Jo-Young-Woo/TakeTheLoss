+    cfg2, g2 = make_world([(3.0, 2.5)], around(3.0, 2.5))
+    cov.cfg = cfg2
+    cov.refresh(g2, None, 12.0, force=True)
+    again = next(iter(cov.boxes.values()))
+    assert again.bid == bid and again.closed is True and again.kind == "full"
