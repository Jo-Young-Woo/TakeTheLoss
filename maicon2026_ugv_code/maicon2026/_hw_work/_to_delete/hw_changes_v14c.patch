+# ------------------------------------------------------------------------------------------ CLI
+def run_cli(*args):
+    return subprocess.run([sys.executable, str(ROOT / "scripts" / "field_exp.py"), *args], cwd=str(ROOT), capture_output=True,
+                          text=True, encoding="utf-8", timeout=120)
