+def _measured_cfg():
+    cfg = Config()
+    cfg.arena = ArenaGeometry.from_spec(yaml.safe_load((PACKAGE / "config/arena_spec.yaml").read_text(encoding="utf-8")))
+    cfg.team, cfg.slot = "BLUE", 2
+    cfg.hal.restart_state_path = None
