+    assert t_enemy.ident is None
+    assert slots(tr, 1.0)["B-UGV-1"]["x"] == pytest.approx(0.4)                     # 위치 갱신 없음
+    feed(tr, 2.0, (0.7, 3.9), B2, B3)                                               # 색 없는 검출은 이어진다(상대 색 검출은 후보에서 제외)
+    assert slots(tr, 2.0)["B-UGV-1"]["state"] == "tracked"
+
+
+def test_uncoloured_detection_near_a_friend_track_does_not_hijack_it_from_the_camera_side():
+    tr = tracker()
+    feed(tr, 0.0, B1, B2, B3)
+    t1 = track_of(tr, "B-UGV-1")
+    # 카메라가 색 없이 근처를 봤다 — 예약된 트랙에 합쳐지면 안 된다
+    tr._upsert(0.5, 4.1, 0.5, None, 0.9, "cam")
+    assert track_of(tr, "B-UGV-1") is t1 and (t1.x, t1.y) == pytest.approx(B1)
+    assert any(t.ident is None and abs(t.x - 0.5) < 0.01 for t in tr.tracks)        # 별도 '식별 안 됨' 트랙
+
+
+# ====================================================================== 카메라 보강
+def test_camera_reading_the_team_colour_keeps_the_friend_tracked_while_video_is_missing():
+    tr = tracker()
+    feed(tr, 0.0, B1, B2, B3)
+    for i in range(1, 8):                                                           # UAV 영상 없음, 카메라가 1 번의 아군 색을 계속 본다
+        tr._upsert(0.4 + 0.05 * i, 4.16, float(i), "BLUE", 0.9, "cam")
+        tr.tick_friends(float(i))
+    s = slots(tr, 7.0)
+    assert s["B-UGV-1"]["state"] == "tracked" and s["B-UGV-1"]["age_s"] == pytest.approx(0.0)
+    assert s["B-UGV-3"]["state"] == "unidentified"                                  # 3 번은 못 봐서 놓침
+
+
+def test_camera_colour_between_two_friends_is_not_credited_to_either():
+    tr = tracker()
+    me = (3.0, 4.5)
+    feed(tr, 0.0, B1, B3, me=me)
+    feed(tr, 1.0, (0.4, 3.7), (0.4, 1.3), me=me)
+    feed(tr, 2.0, (0.4, 3.25), (0.4, 1.75), me=me)
+    tr._upsert(0.4, 2.5, 2.5, "BLUE", 0.9, "cam")                                   # 두 아군의 한가운데(0.75 m 씩) — 누구인지 모른다
+    s = slots(tr, 2.5)
+    assert s["B-UGV-1"]["age_s"] == pytest.approx(0.5) and s["B-UGV-3"]["age_s"] == pytest.approx(0.5)   # 확인 시각이 갱신되지 않았다
+    tr._upsert(0.4, 3.3, 2.6, "BLUE", 0.9, "cam")                                   # 1 번에 분명히 가까운 검출은 이어진다
+    s = slots(tr, 2.6)
+    assert s["B-UGV-1"]["age_s"] == pytest.approx(0.0) and s["B-UGV-3"]["age_s"] == pytest.approx(0.6)
+
+
+# ====================================================================== 위협판(피아식별 결과)
+def board_view(tr, now):
+    board = ThreatBoard(tr.cfg, "BLUE")
+    return {t.tid: t for t in board.update(tr, [], now, Pose2D(*B2, 0.0))}
+
+
+def test_tracked_friend_is_friend_and_lost_friend_is_an_unknown_ugv():
+    tr = tracker()
+    feed(tr, 0.0, B1, B2, B3)
+    tid1 = track_of(tr, "B-UGV-1").tid
+    v = board_view(tr, 0.5)
+    assert v[tid1].friend is True and v[tid1].p_enemy < 0.1
+    tr.tick_friends(4.5)                                                            # 놓침
+    v = board_view(tr, 5.0)
+    assert v[tid1].friend is False and v[tid1].p_enemy == pytest.approx(0.5)        # 아군도 적도 아님: 미확인 UGV 로 다룬다
+    assert v[tid1].ident is None
+
+
+def test_lost_friend_with_team_colour_votes_is_a_friend_without_a_number():
+    tr = tracker()
+    feed(tr, 0.0, B1, B2, B3)
+    t1 = track_of(tr, "B-UGV-1")
+    tr.tick_friends(4.5)
+    for i in range(4):
+        tr._upsert(t1.x, t1.y, 5.0 + i * 0.1, "BLUE", 0.9, "cam")                   # 놓친 뒤 카메라가 아군 색을 읽는다
+    v = board_view(tr, 5.5)
+    assert v[t1.tid].friend is True and v[t1.tid].ident is None
+
+
+# ====================================================================== 보고용 표현
+def test_snapshot_and_summary_are_json_safe_and_hide_nothing_about_loss():
+    tr = tracker()
+    feed(tr, 0.0, B1, B2, B3)
+    tr.tick_friends(9.0)
+    out = json.loads(json.dumps(tr.fmap.summary(9.0), allow_nan=False))
+    assert {s["ident"]: s["state"] for s in out["slots"]} == {"B-UGV-1": "unidentified", "B-UGV-3": "unidentified"}
+    assert [e["kind"] for e in out["events"]].count("lost") == 2
+    assert out["stats"]["lost_timeout"] == 2
+
+
+def test_red_team_uses_red_slots():
+    tr = UgvTracker(cfg_on(), "RED")
+    tr.update_uav(frame(0.0, (5.72, 4.16), (5.72, 2.5), (5.72, 0.83)), Pose2D(5.72, 0.83, 0.0), self_ident="R-UGV-3")
+    assert {s["ident"] for s in tr.fmap.snapshot(0.0)} == {"R-UGV-1", "R-UGV-2"}
+    assert all(s["state"] == "tracked" for s in tr.fmap.snapshot(0.0))
+
+
+def test_self_detection_that_was_not_filtered_is_not_taken_as_a_friend():
+    tr = tracker()
+    feed(tr, 0.0, B1, B2, B3)
+    # 자기 검출이 자기 자세와 0.3 m 어긋나 필터를 못 통과한 프레임 — 아군 1 번 근처가 아니라 자기 근처라 후보에서 빠진다
+    tr.update_uav(frame(1.0, B1, (0.55, 2.6), B3), Pose2D(0.6, 2.7, 0.0), self_ident=None)
+    s = slots(tr, 1.0)
+    assert s["B-UGV-1"]["state"] == "tracked" and s["B-UGV-3"]["state"] == "tracked"
+
+
+# ====================================================================== 매니저
+class NullLink(ServerLink):
+    def poll(self):
+        return []
+
+    def submit(self, kind, payload):
+        return True
+
+
+class NoDet(Detector):
+    def detect(self, frame):
+        return []
+
+
+def make_agent(**over):
+    cfg = cfg_on(**over)
+    cfg.nav.backend = "builtin"
+    robot, _, clock = make_robot("practice", "idle", cfg=cfg)
+    agent = Agent(robot, NullLink(), cfg=cfg, detector=NoDet())
+    agent.team, agent.slot = "BLUE", 2
+    agent.tracker = UgvTracker(cfg, "BLUE")
+    agent.stack = MagicMock()
+    agent.stack.pose = Pose2D(*B2, 0.0)
+    logs = []
+    agent._log = lambda now, msg: logs.append(msg)
+    return agent, logs
+
+
+def test_manager_logs_birth_and_loss_once_and_publishes_the_map():
+    agent, logs = make_agent()
+    feed(agent.tracker, 0.0, B1, B2, B3)
+    agent._friend_report(0.1)
+    assert sum("추적 시작" in m for m in logs) == 2
+    agent._friend_report(0.2)
+    assert sum("추적 시작" in m for m in logs) == 2                                  # 같은 사건을 다시 쓰지 않는다
+    assert agent.stats["friend_map"]["slots"][0]["state"] == "tracked"
+    agent._friend_report(9.0)                                                       # 영상 없이 시간만 흘렀다
+    assert sum("식별 안 됨" in m for m in logs) == 2 and any("다시 이어 붙이지 않는다" in m for m in logs)
+    assert agent.stats["friend_map"]["slots"][0]["state"] == "unidentified"
+    json.dumps(agent.stats["friend_map"], allow_nan=False)
+
+
+def test_manager_report_is_a_noop_when_off_and_never_raises():
+    agent, logs = make_agent()
+    agent.cfg.avoid.friend_track = False
+    agent.tracker = UgvTracker(agent.cfg, "BLUE")
+    agent._friend_report(1.0)
+    assert "friend_map" not in agent.stats and logs == []
+    agent, logs = make_agent()
+    agent.tracker.tick_friends = MagicMock(side_effect=RuntimeError("x"))
+    agent._friend_report(1.0)                                                       # 예외는 삼킨다
+    assert agent.stats["friend_map_errors"] == 1
+
+
+# ====================================================================== 설정 검증
+def test_sanitize_resets_bad_friend_keys_and_leaves_defaults_alone():
+    from maicon26.validate import sanitize_config
+    assert sanitize_config(Config()) == []
+    cfg = Config()
+    cfg.avoid.friend_lost_s, cfg.avoid.friend_gate_m, cfg.avoid.friend_max_speed = 0.0, float("nan"), 9.0
+    assert set(sanitize_config(cfg)) == {"avoid.friend_lost_s", "avoid.friend_gate_m", "avoid.friend_max_speed"}
+    assert (cfg.avoid.friend_lost_s, cfg.avoid.friend_gate_m, cfg.avoid.friend_max_speed) == (4.0, 0.5, 0.6)
diff -ruN -x __pycache__ -x .pytest_cache a/tests/test_gimbal_settle.py b/tests/test_gimbal_settle.py
--- a/tests/test_gimbal_settle.py	1970-01-01 09:00:00.000000000 +0900
+++ b/tests/test_gimbal_settle.py	2026-11-10 21:59:52.625363776 +0900
@@ -0,0 +1,129 @@
+"""하드웨어 문서 반영 4장: 짐벌 정착 시간 — /mil/gimbal 의 ok 는 접수일 뿐 도착이 아니다(p72). 시뮬 없이 돈다.
+
+기본값(aim.gimbal_settle_s = 0.0)은 발사 시점이 기존과 완전히 같고, 0 보다 크면 '크게 움직인 마지막 명령' 뒤 그 시간 동안 발사를 미룬다.
+"""
+from hw_fakes import FakeTransport, make_robot
+from maicon26.config import Config
+from maicon26.mission.aim import LaserManager
+
+
+def _cfg(settle, move_deg=1.0):
+    cfg = Config()
+    cfg.aim.gimbal_settle_s = settle
+    cfg.aim.settle_move_deg = move_deg
+    return cfg
+
+
+def _robot(settle, **kw):
+    robot, tr, clock = make_robot("practice", "idle", cfg=_cfg(settle, **kw))
+    clock.t += 1.0
+    return robot, tr, clock
+
+
+def _move(robot, clock, pan, tilt=0.0):
+    clock.t += 0.5                                   # gimbal_min_interval_s 보다 길게
+    robot.set_pan_tilt(pan, tilt)
+    robot.pump()
+
+
+def test_default_is_zero_and_fire_timing_is_unchanged():
+    cfg = Config()
+    assert cfg.aim.gimbal_settle_s == 0.0 and cfg.aim.settle_move_deg == 1.0
+    robot, tr, clock = _robot(0.0)
+    _move(robot, clock, 30.0)
+    assert robot.gimbal_settle_left() == 0.0
+    assert robot.laser_fire() is True                # 명령을 막 접수시킨 직후에도 기존처럼 바로 쏜다
+    assert "fire_wait_settle" not in robot.stats
+
+
+def test_big_move_blocks_fire_until_settle_time_has_passed():
+    robot, tr, clock = _robot(0.4)
+    _move(robot, clock, 30.0)
+    assert tr.gimbal and robot.gimbal_settle_left() > 0
+    assert robot.laser_fire() is False and tr.fire == []         # 서비스도 부르지 않는다
+    clock.t += 0.3
+    assert robot.laser_fire() is False
+    clock.t += 0.15                                              # 접수 후 0.45 s > 0.4
+    assert robot.gimbal_settle_left() == 0.0
+    assert robot.laser_fire() is True and tr.fire == [1]
+    assert robot.stats["fire_wait_settle"] == 2
+
+
+def test_small_move_does_not_restart_the_settle_clock():
+    robot, tr, clock = _robot(0.4)
+    _move(robot, clock, 30.0)
+    clock.t += 0.6
+    assert robot.gimbal_settle_left() == 0.0
+    _move(robot, clock, 30.5)                                    # 0.5° < settle_move_deg(1.0)
+    assert len(tr.gimbal) == 2                                   # 명령은 나갔지만
+    assert robot.gimbal_settle_left() == 0.0                     # 정착 시계는 다시 시작하지 않는다
+    assert robot.laser_fire() is True
+
+
+def test_each_new_big_move_restarts_the_clock():
+    robot, tr, clock = _robot(0.4)
+    _move(robot, clock, 30.0)
+    clock.t += 0.6
+    _move(robot, clock, -20.0)
+    assert robot.gimbal_settle_left() > 0.3
+    assert robot.laser_fire() is False
+
+
+def test_settle_move_deg_threshold_is_configurable():
+    robot, tr, clock = _robot(0.4, move_deg=10.0)
+    _move(robot, clock, 30.0)
+    clock.t += 0.6
+    _move(robot, clock, 38.0)                                    # 8° < 10°
+    assert robot.gimbal_settle_left() == 0.0
+    _move(robot, clock, 55.0)                                    # 17° > 10°
+    assert robot.gimbal_settle_left() > 0
+
+
+def test_unanswered_big_move_counts_as_not_settled():
+    tr = FakeTransport()
+    tr.gimbal_pending = []                                       # 접수 응답이 아직 안 왔다
+    robot, tr, clock = make_robot("practice", "idle", cfg=_cfg(0.4), transport=tr)
+    clock.t += 1.0
+    _move(robot, clock, 30.0)
+    assert robot.gimbal_settle_left() == 0.4
+    assert robot.laser_fire() is False
+    clock.t += 0.1
+    tr.gimbal_pending.pop(0)("ok")                               # 접수
+    assert robot.gimbal_settle_left() > 0.3
+    clock.t += 0.5
+    assert robot.laser_fire() is True
+
+
+def test_rejected_or_locked_gimbal_command_does_not_start_the_clock():
+    tr = FakeTransport(gimbal_reply="locked")
+    robot, tr, clock = make_robot("practice", "idle", cfg=_cfg(0.4), transport=tr)
+    clock.t += 1.0
+    _move(robot, clock, 30.0)
+    assert robot.gimbal_settle_left() == 0.0                     # 접수되지 않았으니 움직이지 않았다
+
+
+def test_laser_manager_goes_through_the_same_single_gate():
+    robot, tr, clock = _robot(0.4)
+    _move(robot, clock, 30.0)
+    lm = LaserManager(robot.cfg, robot)
+    assert lm.fire(clock.t) is False and lm.shots == 0           # 낭비로 세지 않는다
+    clock.t += 0.5
+    assert lm.fire(clock.t) is True and lm.shots == 1
+
+
+def test_resume_resends_the_pose_and_restarts_the_settle_clock():
+    robot, tr, clock = _robot(0.4)
+    robot.on_match("mission", "start")
+    _move(robot, clock, 30.0)
+    clock.t += 0.6
+    assert robot.laser_fire() is True                            # 정착 완료 후 정상 발사
+    n = len(tr.gimbal)
+    robot.on_match("mission", "pause")
+    clock.t += 15.0                                              # 발광·재장전 대기도 끝난 뒤
+    robot.on_match("mission", "resume")                          # 재개: 팬틸트 재전송 강제(p12) — 이전 접수 사실을 믿지 않는다
+    robot.pump()
+    assert len(tr.gimbal) == n + 1
+    assert robot.gimbal_settle_left() > 0.3
+    assert robot.laser_fire() is False
+    clock.t += 0.5
+    assert robot.laser_fire() is True
diff -ruN -x __pycache__ -x .pytest_cache a/tests/test_hw_baseline_equivalence.py b/tests/test_hw_baseline_equivalence.py
--- a/tests/test_hw_baseline_equivalence.py	1970-01-01 09:00:00.000000000 +0900
+++ b/tests/test_hw_baseline_equivalence.py	2026-11-10 21:38:30.497934006 +0900
@@ -0,0 +1,58 @@
+"""하드웨어 반영 수정 후에도 기본 동작이 하나도 바뀌지 않았는지 — 수정 전에 저장한 기준값과 비교한다.
+
+기준값: tests/fixtures/hw_baseline/*.json (scripts/capture_hw_baseline.py 가 수정 전에 한 번 만들었다. 덮어쓰지 않는다).
+시뮬레이션을 쓰지 않는다. 실수는 1e-12 안에서, 그 밖은 정확히 같아야 한다.
+"""
+import json
+import math
+import sys
+from pathlib import Path
+
+import pytest
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT / "scripts"))
+import capture_hw_baseline as cap  # noqa: E402
+
+FIX = ROOT / "tests" / "fixtures" / "hw_baseline"
+TOL = 1e-12
+
+
+def assert_same(a, b, path="$"):
+    if isinstance(a, bool) or isinstance(b, bool) or a is None or b is None:
+        assert a == b, f"{path}: {a!r} != {b!r}"
+    elif isinstance(a, (int, float)) and isinstance(b, (int, float)):
+        if isinstance(a, float) or isinstance(b, float):
+            assert math.isclose(a, b, rel_tol=TOL, abs_tol=TOL), f"{path}: {a!r} != {b!r}"
+        else:
+            assert a == b, f"{path}: {a!r} != {b!r}"
+    elif isinstance(a, dict) and isinstance(b, dict):
+        assert set(a) == set(b), f"{path}: keys {sorted(set(a) ^ set(b))}"
+        for k in a:
+            assert_same(a[k], b[k], f"{path}.{k}")
+    elif isinstance(a, (list, tuple)) and isinstance(b, (list, tuple)):
+        assert len(a) == len(b), f"{path}: len {len(a)} != {len(b)}"
+        for i, (x, y) in enumerate(zip(a, b)):
+            assert_same(x, y, f"{path}[{i}]")
+    else:
+        assert a == b, f"{path}: {a!r} != {b!r}"
+
+
+@pytest.mark.parametrize("name", sorted(cap.COLLECTORS))
+def test_default_behaviour_matches_saved_baseline(name):
+    saved = json.loads((FIX / f"{name}.json").read_text(encoding="utf-8"))
+    now = json.loads(json.dumps(cap._jsonable(cap.COLLECTORS[name]())))
+    assert_same(now, saved)
+
+
+def test_frozen_runtime_hashes_unchanged_when_runtime_is_present():
+    saved = json.loads((FIX / "frozen_runtime_sha256.json").read_text(encoding="utf-8"))
+    now = cap.frozen_runtime_hashes()
+    if not now["present"]:
+        pytest.skip("runtime/selected_candidate02 가 이 PC 에 없다 — 동결 런타임이 있는 PC 에서 --check-frozen 으로 확인")
+    assert now["files"] == saved["files"]
+
+
+def test_baseline_files_are_complete():
+    expected = set(cap.COLLECTORS) | {"frozen_runtime_sha256"}
+    assert expected == {p.stem for p in FIX.glob("*.json")}
diff -ruN -x __pycache__ -x .pytest_cache a/tests/test_laser_zero.py b/tests/test_laser_zero.py
--- a/tests/test_laser_zero.py	1970-01-01 09:00:00.000000000 +0900
+++ b/tests/test_laser_zero.py	2026-11-11 03:45:14.862242467 +0900
@@ -0,0 +1,269 @@
+"""텔레옵 영점(laser_zero.yaml) → aim.laser_* 4개 변환(maicon26/field/laser_zero.py, scripts/field_exp.py zero-import).
+기준은 Gazebo 시뮬 모델이다: 레이저−카메라 영점 위치의 옆(+왼쪽)·위(+) 성분을 laser_lateral_m/vertical_m 로 넣고 축각은 0.
+시뮬을 쓰지 않는다(순수 계산 + 파일 + 하위 프로세스로 CLI)."""
+import json
+import math
+import os
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+import yaml
+
+from maicon26.config import Config
+from maicon26.field import laser_zero as lz
+from maicon26.field import overrides as ov
+from maicon26.field import tunables as tun
+from maicon26.hal.wingbot_calibration import configure_wingbot_simulation
+from maicon26.mission.aim import AimController
+from maicon26.types import Detection
+
+ROOT = Path(__file__).resolve().parents[1]
+DIST = [0.6, 1.0, 1.5, 2.0]
+
+
+def gazebo_cfg():
+    cfg = Config()
+    configure_wingbot_simulation(cfg, ROOT / "ros2/wingbot_description/config/frames.yaml")
+    return cfg
+
+
+def aim_err_at(cfg, u, v, d):
+    """이 설정의 조준 코드가, 거리 d 에서 레이저 점이 찍히는 화면 위치(u, v)에 표적 센서가 있을 때 내는 오차(deg)."""
+    cfg.aim.require_sensor = False
+    ac = AimController(cfg)
+    det = Detection("TANK", 0.9, (u - 30, v - 30, u + 30, v + 30), 0.0, None, {"sensors": [(u, v, 20.0, 0.9)]})
+    _, _, res = ac.update(det, 0.0, 0.0, 1.0, d)
+    return res.err_pan, res.err_tilt
+
+
