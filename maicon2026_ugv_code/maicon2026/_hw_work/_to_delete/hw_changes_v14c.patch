+    assert tr.fmap is None
+    feed(tr, 0.0, B1, B2, B3)
+    assert sorted(t.ident for t in tr.tracks) == ["B-UGV-1", "B-UGV-3"]            # 옛 방식: 거점 근접 ident
+    assert tr.tick_friends(99.0) == []
+
