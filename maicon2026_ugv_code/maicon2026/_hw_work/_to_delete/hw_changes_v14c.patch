+def test_aim_alignment_flips_at_the_tolerance_given_by_angular_extent_at_the_sensor(centre_deg):
+    # 센서 반경이 작으면 허용치 = deg(angular_extent(u, v, sensor_radius_frac·r_px)) 가 거리별 허용치보다 좁아 이쪽이 결정한다.
