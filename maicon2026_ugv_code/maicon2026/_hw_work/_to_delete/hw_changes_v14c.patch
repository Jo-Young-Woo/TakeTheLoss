+# ------------------------------------------------------------------------------------------------ OAK 식별 후보
+def identify_cfg(cfg):
+    cfg.oak_det.enable = True
+    cfg.oak_det.identify_fallback = True
+
+
+def make_unresolved(cfg, g, cov, face_idx=2, attempts=2):
+    b = next(iter(cov.boxes.values()))
+    f = b.faces[face_idx]
+    f.arrive_attempts = attempts
+    return b, f
