+        mid = 0.5 * (top_hi + floor_lo)             # 윗면과 바닥의 한가운데 — 조명이 조금 변해도 양쪽에 여유가 있다
+        cap = floor_med / (min_floor_contrast * 1.08)   # 검출기는 바닥 밝기가 문턱의 min_floor_contrast 배 미만이면 프레임을 버린다 — 그 안쪽으로만 제안
