+@dataclass
+class UavBoxReport:
+    ok: bool = False
+    reason: str = ""                             # 프레임 전체를 못 쓴 이유: bad_frame size_mismatch dark_frame bright_frame low_contrast no_cv2
+    boxes: List[UavBox] = field(default_factory=list)
