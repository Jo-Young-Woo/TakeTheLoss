+    b = next(iter(cov.boxes.values()))
+    assert b.closed is None                                                # UGV 가 가린 쪽 — 열림으로 오인하지 않는다
+    assert all(math.hypot(b.cx - 3.45, b.cy - 2.5) > 0.3 for b in cov.boxes.values())
