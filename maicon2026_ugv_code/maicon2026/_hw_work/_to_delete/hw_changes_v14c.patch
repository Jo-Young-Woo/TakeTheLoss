+@dataclass
+class UavCell:
+    """후보 칸 하나. status: accepted(상자로 냄) | ignored(무시 구역) | rejected(기각)."""
+    cx: float
+    cy: float
+    fill: float
+    conf: float
+    status: str
+    reason: str = ""
+    comp: int = 0
