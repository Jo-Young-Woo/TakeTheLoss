+                   why="윗면 밝기 80% 값이 바닥 밝기 20% 값보다 충분히 낮다(문턱은 둘의 한가운데, 바닥 대비 한도 안)")
+    elif top_lo > floor_med + 20 and top_s < 70:    # 윗면이 바닥보다 밝은 회색
