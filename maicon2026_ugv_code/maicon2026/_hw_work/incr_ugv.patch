+def test_virtual_impact_from_a_heading_step_holds_the_robot(make_agent):
+    cfg = Config()
+    cfg.pose_guard.enable = True
+    h = make_agent(cfg, scan=scan_with())
+    a, g = h.agent, h.guard
+    for i in range(30):                                                    # 안정된 기준 오프셋을 배운다
+        g.process(50.0 + 0.1 * i, Pose2D(3.0, 1.5, 0.2), Pose2D(0, 0, 0.2), None)
+    assert g.step_detected(53.0) is None
+    for i in range(6):                                                     # 정지 상태에서 SLAM 헤딩만 8° 계단
+        g.process(53.0 + 0.1 * i, Pose2D(3.0, 1.5, 0.2 + math.radians(8)), Pose2D(0, 0, 0.2), None)
+    a._impact_update(54.0)
+    assert any("IMPACT" in m and "yaw_step" in m for _, m in a._test_logs)
+    assert a._unsafe_reason(54.1, st()) == "impact"
+
+
+def test_pose_lost_stops_and_requires_new_scans(make_agent):
+    cfg = Config()
+    cfg.pose_guard.enable = True
+    h = make_agent(cfg, scan=scan_with())
+    h.guard.state = "lost"
+    assert h.agent._unsafe_reason(100.0, st()) == "pose_lost"
+    h.guard.state = "ok"
+    assert h.agent._unsafe_reason(100.0, st()) is None
+
+
+def test_speed_scale_combines_guard_degradation_and_storm(make_agent):
+    cfg = Config()
+    cfg.impact.enable = True
+    cfg.pose_guard.enable = True
+    h = make_agent(cfg, scan=scan_with())
+    a = h.agent
+    assert a._speed_guard_scale(100.0) == 1.0
+    h.guard.state = "degraded"
+    assert a._speed_guard_scale(100.0) == pytest.approx(cfg.pose_guard.degraded_speed_scale)
+    h.guard.state = "ok"
+    a._impact._slow_until = 200.0
+    assert a._speed_guard_scale(100.0) == pytest.approx(0.6)
+    h.guard.state = "degraded"
+    assert a._speed_guard_scale(100.0) == pytest.approx(min(0.6, cfg.pose_guard.degraded_speed_scale))
+
+
+def test_uav_map_pose_subtracts_the_uav_alignment_and_reports_state(make_agent):
+    cfg = Config()
+    cfg.pose_guard.enable = True
+    h = make_agent(cfg, scan=scan_with(), pose=Pose2D(3.0, 1.5, 0.3))
+    a = h.agent
+    assert a.uav_map_pose() == {"x": 3.0, "y": 1.5, "th": 0.3, "aligned": False, "state": "ok"}
+    a.coverage.uav_alignment_report = {"dx": 0.12, "dy": -0.05, "matches": 3, "rms": 0.02, "t": 1.0}
+    assert a.uav_map_pose()["x"] == pytest.approx(2.88) and a.uav_map_pose()["y"] == pytest.approx(1.55)
+    h.guard.state = "degraded"
+    assert a.uav_map_pose()["state"] == "degraded"
+
+
+def test_pose_guard_tick_reports_map_link_and_warns_on_alignment_change(make_agent):
+    cfg = Config()
+    cfg.pose_guard.enable = True
+    h = make_agent(cfg, scan=scan_with())
+    a, g = h.agent, h.guard
+    g.process(50.0, Pose2D(3.0, 1.5, 0.0), Pose2D(0, 0, 0.0), None)
+    a.coverage.uav_alignment_report = {"dx": 0.02, "dy": 0.0, "matches": 3, "rms": 0.02, "t": 1.0}
+    a._pose_guard_tick(60.0, g)
+    ml = a.stats["map_link"]
+    assert ml["uav_alignment"]["dx"] == 0.02 and ml["pose_state"] == "ok" and ml["uav_map_pose"]["aligned"]
+    assert not any("정렬이" in m for _, m in a._test_logs)
+    a.coverage.uav_alignment_report = {"dx": 0.20, "dy": 0.0, "matches": 3, "rms": 0.02, "t": 2.0}
+    a._pose_guard_tick(62.0, g)
+    assert any("UAV↔LiDAR 정렬이" in m for _, m in a._test_logs)
diff -ruN -x __pycache__ -x .pytest_cache applied/tests/test_nav_stack_pose_guard.py work/tests/test_nav_stack_pose_guard.py
--- applied/tests/test_nav_stack_pose_guard.py	1970-01-01 09:00:00.000000000 +0900
+++ work/tests/test_nav_stack_pose_guard.py	2026-11-11 11:53:45.881992925 +0900
@@ -0,0 +1,137 @@
+"""Nav2Stack 에 건 PoseGuard: 꺼져 있으면 예전과 같고, 켜면 TF 끊김 추측항법·LiDAR 틀어짐 보정·내장 A* 전환·복구 보정이 된다.
+ROS 없이 스텁 클라이언트로 돈다."""
+import math
+
+import numpy as np
+import pytest
+
+from maicon26.config import Config
+from maicon26.nav.nav2_stack import Anchor, Nav2Stack
+from maicon26.types import Pose2D, Scan
+
+from test_nav_stack import StubClient, _free_scan
+
+
+def wall_scan(r=1.0, stamp=1.0):
+    n = 360
+    return Scan(angle_min=-math.pi, angle_inc=2 * math.pi / n, ranges=np.full(n, r), stamp=stamp, range_max=8.0)
+
+
+def make(guard=True, arena=Pose2D(3.0, 1.5, 0.0), m0=(0.0, 0.0, 0.0), **over):
+    cfg = Config()
+    cfg.pose_guard.enable = guard
+    cfg.pose_guard.link_check = False                               # 합성 스캔(원)은 경기장 정합과 무관하다 — 경기장 연결 점검은 test_pose_guard 가 맡는다
+    for k, v in over.items():
+        setattr(cfg.pose_guard, k, v)
+    cl = StubClient(m0)
+    st = Nav2Stack(cfg, cl)
+    st.anchor = Anchor.from_pair(arena, m0)
+    st.pose = arena.copy()
+    return st, cl
+
+
+def run_updates(st, cl, t0, seconds, odom, m=None, hz=10.0, scan=True):
+    t = t0
+    for _ in range(int(seconds * hz)):
+        t += 1.0 / hz
+        if m is not None:
+            cl.m = m
+        st.update(odom, wall_scan(stamp=t) if scan else None, t)
+    return t
+
+
+def test_default_has_no_guard_and_pose_follows_tf():
+    st, cl = make(guard=False)
+    assert st.guard is None
+    cl.m = (0.3, 0.1, 0.2)
+    st.update(Pose2D(), None, 1.0)
+    assert (st.pose.x, st.pose.y, st.pose.th) == pytest.approx(st.anchor.to_arena(0.3, 0.1, 0.2))
+    cl.m = None                                                     # TF 가 끊기면 직전 자세 유지(예전과 같다)
+    p = st.pose.copy()
+    st.update(Pose2D(0.2, 0.0, 0.0), None, 1.1)
+    assert (st.pose.x, st.pose.y) == (p.x, p.y)
+    assert st.diagnostics()["pose_guard"] is None
+
+
+def test_guard_follows_tf_when_nothing_is_wrong():
+    st, cl = make()
+    t = run_updates(st, cl, 0.0, 3.0, Pose2D(0, 0, 0), m=(0.0, 0.0, 0.0))
+    assert st.guard.state == "ok" and (st.pose.x, st.pose.y, st.pose.th) == pytest.approx((3.0, 1.5, 0.0), abs=1e-6)
+    assert st.diagnostics()["pose_guard"]["state"] == "ok"
+
+
+def test_tf_loss_is_bridged_by_odometry_then_declared_lost():
+    st, cl = make()
+    t = run_updates(st, cl, 0.0, 2.0, Pose2D(0, 0, 0), m=(0.0, 0.0, 0.0))
+    cl.m = None
+    odom = Pose2D(0, 0, 0)
+    for i in range(10):                                              # 1 s 동안 0.2 m/s 로 전진
+        t += 0.1
+        odom = Pose2D(odom.x + 0.02, 0.0, 0.0)
+        st.update(odom, None, t)
+    assert st.pose.x == pytest.approx(3.0 + 0.2, abs=0.02) and st.guard.state == "degraded"
+    for i in range(40):                                              # 더 오래 끊기면 lost
+        t += 0.1
+        st.update(odom, None, t)
+    assert st.guard.state == "lost" and "tf_lost" in st.guard.reasons
+
+
+def test_lidar_shift_after_impact_is_compensated_and_forces_builtin_astar():
+    st, cl = make()
+    g = st.guard
+    odom = Pose2D(0, 0, 0)
+    t = run_updates(st, cl, 0.0, 8.0, odom, m=(0.0, 0.0, 0.0))        # 충격 전 안정
+    delta = math.radians(7.0)
+    g.mark_impact(t, "major", 0.0, "accel")
+    t = run_updates(st, cl, t, 3.0, odom, m=(0.0, 0.0, delta))        # 충격 뒤 SLAM 헤딩만 7° 틀어짐(차체는 안 돌았다)
+    assert g.shift == pytest.approx(delta, abs=math.radians(0.7))
+    assert st.pose.th == pytest.approx(0.0, abs=math.radians(0.8))     # 보정된 자세는 차체 헤딩을 따른다
+    assert g.needs_builtin_nav
+    st.set_goal((4.0, 1.5), tol=0.1)
+    st.step(wall_scan(), t + 0.1, 0.05)
+    assert st._fallback and "내장 A*" in st.fallback_reason and st.fallbacks == 1
+
+
+def test_small_shift_stays_on_nav2():
+    st, cl = make()
+    g = st.guard
+    odom = Pose2D(0, 0, 0)
+    t = run_updates(st, cl, 0.0, 8.0, odom, m=(0.0, 0.0, 0.0))
+    g.mark_impact(t, "minor", 0.0, "accel")
+    t = run_updates(st, cl, t, 3.0, odom, m=(0.0, 0.0, math.radians(3.5)))
+    assert g.shift == pytest.approx(math.radians(3.5), abs=math.radians(0.7)) and not g.needs_builtin_nav
+    st.set_goal((4.0, 1.5), tol=0.1)
+    st.step(wall_scan(), t + 0.1, 0.05)
+    assert not st._fallback
+
+
+def test_scan_none_skips_grid_integration_but_not_pose():
+    st, cl = make(guard=False)
+    st.update(Pose2D(), wall_scan(1.0), 1.0)
+    before = st.grid.L.copy()
+    assert (before != 0).any()
+    cl.m = (0.5, 0.0, 0.0)
+    st.update(Pose2D(), None, 1.1)
+    assert (st.grid.L == before).all() and st.pose.x == pytest.approx(3.5)
+
+
+def test_apply_trim_keeps_arena_pose_consistent_and_republishes_walls():
+    st, cl = make(m0=(0.4, -0.2, 0.3), arena=Pose2D(3.0, 1.5, 0.1))
+    st.update(Pose2D(), None, 1.0)
+    p = st.pose.copy()
+    walls_before = cl.walls
+    cancels = cl.cancels
+    st._apply_trim((0.05, -0.03, math.radians(2.0)))
+    x, y, th = st.anchor.to_arena(0.4, -0.2, 0.3)                      # 같은 map 자세를 새 앵커로 옮기면
+    assert (x, y) == pytest.approx((p.x + 0.05, p.y - 0.03), abs=1e-9)
+    assert th == pytest.approx(p.th + math.radians(2.0), abs=1e-9)
+    assert (st.pose.x, st.pose.y) == pytest.approx((x, y), abs=1e-9)
+    assert cl.cancels == cancels + 1 and st.trims_applied == 1 and st.guard.trims_applied == 1
+    assert cl.walls is not None and (walls_before is None or not np.array_equal(cl.walls, walls_before))
+
+
+def test_diagnostics_carry_guard_report():
+    st, cl = make()
+    run_updates(st, cl, 0.0, 1.0, Pose2D(), m=(0.0, 0.0, 0.0))
+    d = st.diagnostics()
+    assert d["pose_guard"]["state"] == "ok" and d["trims_applied"] == 0
diff -ruN -x __pycache__ -x .pytest_cache applied/tests/test_oak_depth_ingest.py work/tests/test_oak_depth_ingest.py
--- applied/tests/test_oak_depth_ingest.py	1970-01-01 09:00:00.000000000 +0900
+++ work/tests/test_oak_depth_ingest.py	2026-11-11 12:07:41.022737788 +0900
@@ -0,0 +1,133 @@
+"""Agent._ingest_oak: OAK Depth 로 상대 UGV 거리·피아식별 연결(oak_det.depth_range / ugv_only). 가짜 로봇·가짜 검출기만 쓴다(시뮬·ROS 없음).
+- 깊이 프레임이 있으면 UGV 트랙 거리는 깊이(how='depth'), 없으면 기존(크기) 경로 그대로.
+- ugv_only 는 면(물체 지도) 득표를 내지 않는다. 어느 경우에도 조준·사격 목록은 비어 있다."""
+import numpy as np
+import pytest
+
+from test_oak_geometry_priority import H, K, W, cfg_oak, det, make_agent, push_oak
+from test_oak_ugv_range import FX, scene
+from maicon26.types import DepthFrame
+
+DEPTH_K = (FX, 0.0, W / 2, 0.0, FX, H / 2, 0.0, 0.0, 1.0)
+
+
+def _ugv(z=1.2, team="RED"):
+    d, box = scene(z)
+    return d, box, _det_from_box(box, team)
+
+
+def _det_from_box(box, team):
+    from maicon26.types import Detection
+    return Detection("UGV", 0.9, tuple(box), 0.0, team, {})
+
+
+def _push_depth(robot, depth, stamp):
+    robot._depth = DepthFrame(depth.astype(np.float32), stamp, K=DEPTH_K)
+
+
+def _agent(**over):
+    cfg = cfg_oak(**over)
+    return make_agent(cfg)
+
+
+def test_default_has_no_depth_ranger_and_no_depth_stats():
+    agent, robot, tr, clock, d = make_agent()
+    assert agent._depth_ranger is None
+    clock.t = 1.0
+    push_oak(robot, clock)
+    d.oak = [det("UGV", u=640.0, h=220.0, w=160.0, team="RED")]
+    agent._ingest_oak(1.0)
+    assert "oak_depth" not in agent.stats
+    assert agent.tracker.depth_stats == {} or sum(agent.tracker.depth_stats.values()) == 0
+
+
+def test_depth_frame_gives_the_ugv_track_a_depth_range_and_boosts_a_near_iff_vote():
+    agent, robot, tr, clock, d = _agent(depth_range=True)
+    clock.t = 1.0
+    push_oak(robot, clock)
+    depth, box, ugv = _ugv(1.2, "RED")
+    _push_depth(robot, depth, 1.0)
+    d.oak = [ugv]
+    agent._ingest_oak(1.0)
+    st = agent.stats["oak_depth"]
+    assert st["ok"] == 1 and agent.tracker.depth_stats["iff_boost"] == 1
+    assert agent.tracker.last_depth_range is not None and agent.tracker.last_depth_range[1] == pytest.approx(1.2, abs=0.05)
+    assert agent.tracker.last_depth_range[2] == "RED"
+    tracks = agent.tracker.enemies(1.1)
+    assert len(tracks) == 1
+    assert agent._dets == []                                                   # 조준·사격이 보는 목록에는 들어가지 않는다
+
+
+def test_far_ugv_keeps_its_position_but_loses_the_unreliable_antenna_colour():
+    agent, robot, tr, clock, d = _agent(depth_range=True, iff_max_range_m=1.0)
+    clock.t = 1.0
+    push_oak(robot, clock)
+    depth, box, ugv = _ugv(1.6, "RED")
+    _push_depth(robot, depth, 1.0)
+    d.oak = [ugv]
+    agent._ingest_oak(1.0)
+    assert agent.tracker.depth_stats["iff_far"] == 1 and agent.tracker.last_depth_range[2] is None
+    assert agent.tracker.tracks                                                # 위치 증거는 남는다
+
+
+def test_no_depth_frame_falls_back_to_the_size_path_and_counts_it():
+    agent, robot, tr, clock, d = _agent(depth_range=True)
+    clock.t = 1.0
+    push_oak(robot, clock)
+    d.oak = [det("UGV", u=640.0, h=220.0, w=160.0, team="RED")]
+    agent._ingest_oak(1.0)                                                     # robot.get_depth() 는 None
+    assert agent.stats["oak_depth"]["no_frame"] >= 1 and agent.stats["oak_depth"]["ok"] == 0
+    assert agent.tracker.tracks and agent.tracker.last_depth_range is None
+
+
+def test_stale_depth_frame_is_not_paired_with_the_detection():
+    agent, robot, tr, clock, d = _agent(depth_range=True, depth_max_dt_s=0.35)
+    clock.t = 1.0
+    push_oak(robot, clock)
+    depth, box, ugv = _ugv(1.2, "RED")
+    _push_depth(robot, depth, 0.2)                                             # 0.8 s 전 영상
+    d.oak = [ugv]
+    agent._ingest_oak(1.0)
+    assert agent.stats["oak_depth"]["no_frame"] >= 1 and agent.tracker.last_depth_range is None
+
+
+def test_ugv_only_feeds_the_tracker_but_never_the_object_map():
+    agent, robot, tr, clock, d = _agent(depth_range=True, ugv_only=True)
+    clock.t = 1.0
+    push_oak(robot, clock)
+    depth, box, ugv = _ugv(1.2, "RED")
+    _push_depth(robot, depth, 1.0)
+    d.oak = [det("TANK", conf=0.9, u=300.0), ugv]
+    agent._ingest_oak(1.0)
+    assert agent.stats["oak_ugv_dets"] == 1 and agent.stats["oak_depth"]["ok"] == 1
+    assert agent.omap.faces == [] and agent.stats.get("oak_identify_obs", 0) == 0     # 면 득표 0 — 면 식별은 팬틸트만
+    assert agent.tracker.tracks
+
+
+def test_ugv_only_without_a_ugv_detection_changes_nothing():
+    agent, robot, tr, clock, d = _agent(depth_range=True, ugv_only=True)
+    clock.t = 1.0
+    push_oak(robot, clock)
+    d.oak = [det("TANK", conf=0.9, u=300.0)]
+    agent._ingest_oak(1.0)
+    assert agent.omap.faces == [] and agent.stats["oak_ugv_dets"] == 0 and not agent.tracker.tracks
+
+
+def test_depth_without_ugv_only_still_votes_faces_as_before():
+    agent, robot, tr, clock, d = _agent(depth_range=True, ugv_only=False)
+    clock.t = 1.0
+    push_oak(robot, clock)
+    d.oak = [det("TANK", conf=0.8, u=640.0, h=200.0, w=160.0)]
+    agent._ingest_oak(1.0)
+    assert agent.omap.faces and agent.omap.faces[0].votes["TANK"] == pytest.approx(0.8 * 0.5)
+
+
+def test_misaligned_depth_config_is_ignored_not_trusted():
+    agent, robot, tr, clock, d = _agent(depth_range=True, depth_aligned_to_rgb=False)
+    clock.t = 1.0
+    push_oak(robot, clock)
+    depth, box, ugv = _ugv(1.2, "RED")
+    _push_depth(robot, depth, 1.0)
+    d.oak = [ugv]
+    agent._ingest_oak(1.0)
+    assert agent.stats["oak_depth"]["not_aligned"] >= 1 and agent.tracker.last_depth_range is None and agent.tracker.tracks
diff -ruN -x __pycache__ -x .pytest_cache applied/tests/test_oak_ugv_range.py work/tests/test_oak_ugv_range.py
--- applied/tests/test_oak_ugv_range.py	1970-01-01 09:00:00.000000000 +0900
+++ work/tests/test_oak_ugv_range.py	2026-11-11 11:46:25.928836392 +0900
@@ -0,0 +1,180 @@
+"""OAK Depth 로 상대 UGV 거리·피아식별(perception/oak_range.py + UgvTracker.update_camera(depth=...)). ROS·카메라 없이 합성 깊이 영상으로 본다."""
+from __future__ import annotations
+
+import math
+
+import numpy as np
+import pytest
+
+from maicon26.config import Config
+from maicon26.perception.camera import oak_obs_camera
+from maicon26.perception.oak_range import UgvDepthRanger, depth_range_for_box, pick_frame
+from maicon26.perception.tracks import UgvTracker
+from maicon26.types import DepthFrame, Detection, Frame, Pose2D
+
+W, H = 1280, 720
+FX = (W / 2) / math.tan(math.radians(69.0 / 2))
+K = (FX, 0.0, W / 2, 0.0, FX, H / 2, 0.0, 0.0, 1.0)
+
+
+def scene(z_ugv=1.2, width_m=0.30, cx_px=640.0, wall=3.0, size=(W, H)):
+    """벽(wall m) 앞에 폭 width_m 인 UGV(z_ugv m). 반환: 깊이(m), UGV 상자(px)."""
+    sw, sh = size
+    sx = sw / W
+    d = np.full((sh, sw), wall, dtype=np.float32)
+    pw = FX * width_m / z_ugv
+    box = (cx_px - pw / 2, 360 - 0.55 * pw, cx_px + pw / 2, 360 + 0.45 * pw)
+    d[int(box[1] * sx):int(box[3] * sx), int(box[0] * sx):int(box[2] * sx)] = z_ugv
+    return d, box
+
+
+def cfg():
+    c = Config()
+    c.oak_det.depth_range = True
+    return c
+
+
+def test_range_of_ugv_in_front_of_wall():
+    d, box = scene(1.2)
+    r = depth_range_for_box(d, box, (W, H), fx=FX, cx=W / 2)
+    assert r is not None and r.z == pytest.approx(1.2, abs=0.02) and r.r == pytest.approx(1.2, abs=0.02)
+    assert r.width_m == pytest.approx(0.30, abs=0.01) and r.quality > 0.9
+
+
+def test_off_axis_range_is_horizontal_distance():
+    d, box = scene(1.2, cx_px=1000.0)
