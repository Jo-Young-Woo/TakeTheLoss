+    assert len(boxes) == 20 and missing == 0 and extra == 0
+    assert err < 0.03                                                       # 측정 격자 보정 오차 안(실측 약 1.5 cm)
+    assert all(b.confidence >= 0.6 and b.sx == b.sy == 0.4 for b in boxes)
