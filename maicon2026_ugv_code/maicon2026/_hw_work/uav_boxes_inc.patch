+def _capture_link_kwargs(runtime, monkeypatch):
+    seen = {}
+    original = runtime.Link.__init__
+
+    def init(self, *args, **kwargs):
+        seen.update(kwargs)
+        original(self, *args, **kwargs)
+    monkeypatch.setattr(runtime.Link, "__init__", init)
+    return seen
